    "Software dimming changes the image, not the backlight. It restores on quit and keeps at least 12% brightness.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Software-Abdunklung ändert das Bild, nicht die Hintergrundbeleuchtung. Beim Beenden wird sie zurückgesetzt; mindestens 12 % Helligkeit bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software dimming changes the image, not the backlight. It restores on quit and keeps at least 12% brightness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La atenuación por software cambia la imagen, no la retroiluminación. Se restablece al salir y mantiene al menos un 12 % de brillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assombrissement logiciel modifie l’image, pas le rétroéclairage. Il est réinitialisé à la fermeture et conserve au moins 12 % de luminosité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソフトウェア調光は映像の明るさを変更します。バックライトは変わりません。終了時に元に戻り、明るさは最低 12% を維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소프트웨어 조광은 백라이트가 아닌 영상 밝기를 변경합니다. 종료 시 복원되며 최소 12% 밝기를 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件调暗改变画面亮度，不改变背光。退出时自动恢复；最低保留 12% 画面亮度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "軟體調暗改變畫面亮度，不改變背光。退出時自動恢復；最低保留 12% 畫面亮度。"
          }
        }
      }
    },
