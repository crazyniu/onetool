    "Input source applied, but Caps Lock could not be turned off. Check Accessibility permission.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabequelle angewendet, aber Feststelltaste nicht ausgeschaltet. Prüfe die Bedienungshilfen-Berechtigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input source applied, but Caps Lock could not be turned off. Check Accessibility permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplicó la fuente, pero no se pudo desactivar Bloq Mayús. Revisa el permiso de accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Source appliquée, mais Verr. maj. reste actif. Vérifiez l’autorisation d’accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力ソースは適用されましたが、Caps Lock を解除できません。アクセシビリティ権限を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 소스는 적용되었지만 Caps Lock을 끌 수 없습니다. 손쉬운 사용 권한을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入法已应用，无法关闭大写锁定。请检查辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入法已App，無法關閉大寫鎖定。請檢查輔助功能權限。"
