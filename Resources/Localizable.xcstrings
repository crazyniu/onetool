    "Includes recent and protected files in scanned locations. Only eligible files can be cleaned.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes recent and protected files in scanned locations. Only eligible files can be cleaned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含已扫描位置中的近期和受保护文件，仅符合条件的文件可以清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含已掃描位置中的近期與受保護檔案，僅符合條件的檔案可以清理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンした場所の最近のファイルと保護対象も含みます。条件を満たすファイルのみ削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔한 위치의 최근 파일과 보호된 파일을 포함합니다. 조건에 맞는 파일만 정리할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut les fichiers récents et protégés des emplacements analysés. Seuls les fichiers admissibles peuvent être nettoyés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält aktuelle und geschützte Dateien an gescannten Orten. Nur geeignete Dateien können bereinigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye archivos recientes y protegidos de las ubicaciones analizadas. Solo se pueden limpiar los archivos aptos."
          }
        }
      }
    },
