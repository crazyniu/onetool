    "Enter an exact package name. Installation may download dependencies and run the package's install scripts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an exact package name. Installation may download dependencies and run the package's install scripts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入准确的包名。安装可能下载依赖并运行包的安装脚本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入完整套件名稱。安裝可能下載相依套件並執行安裝指令碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正確な名前を入力してください。依存関係のダウンロードとインストールスクリプトの実行が行われる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 패키지 이름을 입력하세요. 설치 시 의존성을 다운로드하고 설치 스크립트를 실행할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le nom exact. L’installation peut télécharger des dépendances et exécuter des scripts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genauen Paketnamen eingeben. Die Installation kann Abhängigkeiten laden und Installationsskripte ausführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el nombre exacto. La instalación puede descargar dependencias y ejecutar scripts."
          }
        }
      }
    },
    "Enter one package name, such as wget or @scope/package. URLs, paths and command options are not supported.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter one package name, such as wget or @scope/package. URLs, paths and command options are not supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入单个包名，如 wget 或 @scope/package。不支持网址、路径和命令选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入單一套件名稱，例如 wget 或 @scope/package。不支援網址、路徑及指令選項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "wget や @scope/package など、名前を1つ入力してください。URL、パス、オプションには対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "wget 또는 @scope/package 같은 이름 하나를 입력하세요. URL, 경로, 명령 옵션은 지원하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
