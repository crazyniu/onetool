    "Files are checked again before cleanup. Changed or busy files are skipped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are checked again before cleanup. Changed or busy files are skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理前会再次核对文件，已变化或正被占用的文件会跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理前會再次核對檔案，已變更或正在使用的檔案會略過。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien werden erneut geprüft. Geänderte oder verwendete Dateien werden übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se revisan de nuevo. Se omiten los modificados o en uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont revérifiés. Ceux modifiés ou utilisés sont ignorés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行前に再確認し、変更済み・使用中のファイルをスキップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 전 다시 확인하며 변경되었거나 사용 중인 파일은 건너뜁니다."
          }
        }
      }
    },
