{
  "sourceLanguage": "en",
  "strings": {
    "Change Duration…": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauer ändern…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change Duration…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar duración…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer la durée…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間を変更…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 변경…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改时长…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改時長…"
          }
        }
      }
    },
    "macOS still controls lid closure, shutdown, and forced sleep.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuklappen, Ausschalten und erzwungener Ruhezustand werden weiterhin von macOS gesteuert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS still controls lid closure, shutdown, and forced sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sigue controlando el cierre de la tapa, el apagado y el reposo forzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS contrôle toujours la fermeture du capot, l’arrêt et la veille forcée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋を閉じたときの動作、システム終了、強制スリープは引き続きmacOSが管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개 닫기, 시스템 종료 및 강제 잠자기는 계속 macOS에서 제어합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖、关机和强制休眠仍由 macOS 控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "闔蓋、關機和強制休眠仍由 macOS 控制。"
          }
        }
      }
    },
    "Changing the duration restarts the timer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Änderung der Dauer startet den Timer neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the duration restarts the timer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar la duración, el temporizador vuelve a empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer la durée redémarre le minuteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間を変更するとタイマーが最初から再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 변경하면 타이머가 처음부터 다시 시작됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改时长后将从现在重新计时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改時長後將從現在重新計時。"
          }
        }
      }
    },
    "Prevent automatic sleep when your Mac is idle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert den automatischen Ruhezustand bei Inaktivität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent automatic sleep when your Mac is idle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que el Mac entre en reposo automáticamente cuando está inactivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche la mise en veille automatique lorsque le Mac est inactif."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macを操作していないときの自動スリープを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 사용하지 않을 때 자동으로 잠자기에 들어가지 않도록 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免 Mac 在无人操作时自动进入休眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免 Mac 在無人操作時自動進入休眠。"
          }
        }
      }
    },
    "Advanced Sleep Options": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterte Ruhezustandsoptionen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced Sleep Options"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opciones avanzadas de reposo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Options de veille avancées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープの詳細設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고급 잠자기 옵션"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级休眠选项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進階休眠選項"
          }
        }
      }
    },
    "Icons are sized for the menu bar. Green means Keep Awake is on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbole in Menüleistengröße. Grün bedeutet: Der Mac bleibt wach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icons are sized for the menu bar. Green means Keep Awake is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iconos ajustados a la barra de menús. El verde indica que Mantener activo está encendido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Icônes adaptées à la barre des menus. Le vert indique que le maintien en éveil est actif."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーに適したサイズです。緑色はスリープ防止が有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에 맞춘 아이콘입니다. 녹색은 잠자기 방지가 켜져 있음을 나타냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标按状态栏尺寸绘制，绿色表示已开启防休眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示按狀態列尺寸繪製，綠色表示已開啟防止休眠。"
          }
        }
      }
    },
