    "Access is checked without showing permission prompts. Choose an action when you need it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access is checked without showing permission prompts. Choose an action when you need it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查状态不会弹出授权请求，需要时再主动授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查狀態不會彈出授權要求，需要時再主動授權。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung zeigt keine Berechtigungsdialoge. Wählen Sie bei Bedarf eine Aktion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación no muestra solicitudes de permiso. Elige una acción cuando la necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification n’affiche aucune demande. Choisissez une action au besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認だけでは許可ダイアログを表示しません。必要な操作を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태 확인 시 권한 요청을 표시하지 않습니다. 필요할 때 작업을 선택하세요."
          }
        }
      }
    },
