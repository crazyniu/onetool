    "Closing the window keeps the app in the menu bar. Quitting ends keep-awake sessions and resets software dimming.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Schließen des Fensters bleibt die App in der Menüleiste. Beenden stoppt das Wachhalten und setzt die Software-Abdunklung zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the window keeps the app in the menu bar. Quitting ends keep-awake sessions and resets software dimming."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar la ventana, la app permanece en la barra de menús. Al salir, termina el mantenimiento activo y se restablece la atenuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer la fenêtre conserve l’app dans la barre des menus. Quitter arrête le maintien en éveil et réinitialise l’assombrissement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを閉じてもメニューバーで動作します。終了するとスリープ防止を停止し、ソフトウェア調光を元に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창을 닫아도 메뉴 막대에서 실행됩니다. 앱을 종료하면 잠자기 방지와 소프트웨어 조광이 해제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭窗口后继续在状态栏运行。退出应用会结束防休眠并恢复软件调暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉視窗後繼續在選單列執行。結束 App 會停止防休眠並恢復軟體調暗。"
          }
        }
      }
    },
