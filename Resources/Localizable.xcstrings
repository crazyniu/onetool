    "Choose an input source for each app. Per-app rules override the default.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle für jede App eine Eingabequelle. App-Regeln haben Vorrang vor dem Standard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an input source for each app. Per-app rules override the default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una fuente para cada app. Las reglas por app tienen prioridad sobre la predeterminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une source par app. Ces règles remplacent la source par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとに入力ソースを指定します。アプリのルールはデフォルトより優先されます。"
