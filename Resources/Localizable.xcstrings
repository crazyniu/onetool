    "Switching keeps the current IP address and subnet mask, and changes IPv4 from DHCP to Manual. Reserve this IP on your router to avoid address conflicts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching keeps the current IP address and subnet mask, and changes IPv4 from DHCP to Manual. Reserve this IP on your router to avoid address conflicts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换会保留当前 IP 地址和子网掩码，并将 IPv4 从 DHCP 改为手动。请在路由器上保留此 IP，避免地址冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換會保留目前的 IP 位址和子網路遮罩，並將 IPv4 從 DHCP 改為手動。請在路由器上保留此 IP，避免位址衝突。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の IP アドレスとサブネットマスクを維持し、IPv4 を DHCP から手動に変更します。アドレスの競合を避けるため、ルーターでこの IP を予約してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 IP 주소와 서브넷 마스크를 유지하고 IPv4를 DHCP에서 수동으로 변경합니다. 주소 충돌을 방지하려면 라우터에서 이 IP를 예약하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement conserve l’adresse IP et le masque actuels et passe IPv4 de DHCP à Manuel. Réservez cette IP sur le routeur pour éviter les conflits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wechsel behält IP-Adresse und Subnetzmaske bei und stellt IPv4 von DHCP auf manuell um. Reservieren Sie diese IP im Router, um Konflikte zu vermeiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio conserva la IP y la máscara actuales y pasa IPv4 de DHCP a Manual. Reserva esta IP en el router para evitar conflictos."
          }
        }
      }
    },
    "The network connection changed. Refresh and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
