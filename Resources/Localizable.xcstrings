    "Use system glass for navigation and actions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use system glass for navigation and actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为导航和操作区域启用系统玻璃材质。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為導覽和操作區域啟用系統玻璃材質。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemglas für Navigation und Aktionen verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar cristal del sistema en navegación y acciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser le verre système pour la navigation et les actions."
          }
        },
        "ja": {
          "stringUnit": {
