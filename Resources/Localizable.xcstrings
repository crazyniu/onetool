    "Manage global packages for the selected npm installation. Project dependencies are managed in their projects.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage global packages for the selected npm installation. Project dependencies are managed in their projects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理当前所选 npm 的全局包。项目依赖请在对应项目中管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理目前所選 npm 的全域套件。專案相依套件請在對應專案中管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した npm のグローバルパッケージを管理します。プロジェクトの依存関係は各プロジェクトで管理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 npm의 전역 패키지를 관리합니다. 프로젝트 의존성은 각 프로젝트에서 관리하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les paquets globaux du npm choisi. Les dépendances de projet se gèrent dans chaque projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwaltet globale Pakete der gewählten npm-Installation. Projektabhängigkeiten im jeweiligen Projekt verwalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona los paquetes globales del npm seleccionado. Las dependencias de proyecto se gestionan en cada proyecto."
          }
        }
      }
    },
    "Manage installed command-line tools and apps. Check for Updates refreshes Homebrew metadata.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage installed command-line tools and apps. Check for Updates refreshes Homebrew metadata."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理已安装的命令行工具和应用。检查更新会刷新 Homebrew 元数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理已安裝的命令列工具與應用程式。檢查更新會重新整理 Homebrew 中繼資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みツールとアプリを管理します。更新確認で Homebrew の情報を更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 도구와 앱을 관리합니다. 업데이트 확인 시 Homebrew 메타데이터를 갱신합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les outils et apps installés. La recherche de mises à jour actualise les métadonnées Homebrew."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwaltet installierte Werkzeuge und Apps. Die Updateprüfung lädt Homebrew-Metadaten neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona herramientas y apps instaladas. Buscar actualizaciones renueva los metadatos de Homebrew."
          }
        }
