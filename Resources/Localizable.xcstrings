    "Quit this app to clean its cache": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit this app to clean its cache"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出此应用后可清理其缓存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束此應用程式後可清理其快取"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュを削除するにはこのアプリを終了してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
