    "Template content is too large. Shorten it to save.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlageninhalt zu groß. Kürze ihn zum Sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Template content is too large. Shorten it to save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de la plantilla es demasiado grande. Acórtalo para guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle est trop volumineux. Réduisez son contenu pour l’enregistrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートの内容が大きすぎます。短くして保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿 내용이 너무 큽니다. 줄인 후 저장하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板内容过大，请缩短后再保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範本內容過大，請縮短後再保存。"
          }
        }
      }
    },
    "Terminals open at the current folder. Editors and other apps use the system Open action.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminals öffnen den aktuellen Ordner. Andere Apps nutzen die Systemaktion Öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminals open at the current folder. Editors and other apps use the system Open action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los terminales se abren en la carpeta actual. Las demás apps usan la acción Abrir del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les terminaux s’ouvrent dans le dossier actuel. Les autres apps utilisent l’action système Ouvrir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルは現在のフォルダで開きます。エディタなどはシステムの「開く」操作を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널은 현재 폴더에서 열립니다. 편집기 및 다른 앱은 시스템 열기 동작을 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端会切换到当前文件夹；编辑器与其他应用使用系统“打开”操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機會切換到當前檔案夾；編輯器與其他App使用系統“打開”操作。"
          }
        }
      }
    },
    "The app is missing. Choose it again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App fehlt. Wähle sie erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is missing. Choose it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no existe. Vuelve a elegirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app est introuvable. Sélectionnez-la à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが見つかりません。選び直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 없습니다. 다시 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件不存在，请重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "軟體不存在，請重新選擇。"
          }
        }
      }
    },
    "The brightness was not applied. Check ambient light and keyboard status, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Helligkeit wurde nicht übernommen. Prüfe Umgebungslicht und Tastaturstatus und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The brightness was not applied. Check ambient light and keyboard status, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se aplicó el brillo. Revisa la luz ambiental y el estado del teclado e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La luminosité n’a pas été appliquée. Vérifiez la lumière ambiante et l’état du clavier, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るさが適用されませんでした。周囲の明るさとキーボードの状態を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝기가 적용되지 않았습니다. 주변 조명과 키보드 상태를 확인한 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统未应用此亮度，请检查环境光、键盘状态后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統未App此亮度，請檢查環境光、鍵盤狀態後重試。"
          }
        }
      }
    },
    "The display accepts DDC commands but does not report brightness. The percentage shows the requested level. If nothing changes, try software dimming.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Display akzeptiert DDC-Befehle, meldet aber keine Helligkeit. Der Prozentwert zeigt die Vorgabe. Versuche Software-Abdunklung, falls sich nichts ändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display accepts DDC commands but does not report brightness. The percentage shows the requested level. If nothing changes, try software dimming."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla acepta órdenes DDC, pero no informa del brillo. El porcentaje indica el nivel solicitado. Si no cambia, prueba la atenuación por software."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran accepte les commandes DDC sans indiquer sa luminosité. Le pourcentage correspond au niveau demandé. Sinon, essayez l’assombrissement logiciel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DDC コマンドを受け付けていますが、明るさは取得できません。設定値を表示しています。変化がない場合はソフトウェア調光を試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이가 DDC 명령을 수신하지만 밝기를 보고하지 않습니다. 백분율은 요청한 값입니다. 변화가 없으면 소프트웨어 조광을 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器接受 DDC 写入，但未返回亮度。百分比表示本次设置值，请观察屏幕确认；无变化时可改用软件调暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示器接受 DDC 寫入，但未返回亮度。百分比表示本次設定值，請觀察螢幕確認；無變化時可改用軟體調暗。"
          }
        }
      }
    },
    "The favorite folder is missing or inaccessible.": {
      "extractionState": "manual",
