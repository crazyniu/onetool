    "Choose a name before creating a file. Existing files are never overwritten. Word and Excel use blank documents.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle vor dem Erstellen einen Namen. Vorhandene Dateien werden nicht überschrieben. Word und Excel verwenden leere Dokumente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a name before creating a file. Existing files are never overwritten. Word and Excel use blank documents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un nombre antes de crear el archivo. No se sobrescriben archivos existentes. Word y Excel usan documentos en blanco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un nom avant la création. Aucun fichier existant n’est écrasé. Word et Excel utilisent des documents vierges."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成前にファイル名を変更できます。既存のファイルは上書きしません。Word と Excel は空白の文書を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 만들기 전에 이름을 선택하세요. 기존 파일은 덮어쓰지 않습니다. Word 및 Excel은 빈 문서를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件创建前可以修改名称。已有文件不会被覆盖；Word 和 Excel 使用真实空白文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案創建前可以修改名稱。已有檔案不會被覆蓋；Word 和 Excel 使用真實空白文檔。"
          }
        }
      }
    },
