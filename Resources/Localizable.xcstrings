    "The command produced too much output. Refresh to check the current package state.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command produced too much output. Refresh to check the current package state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令输出过多。请刷新以检查包的当前状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令輸出過多。請重新整理以檢查套件目前狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力が多すぎます。更新して現在の状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 출력이 너무 많습니다. 새로 고쳐 현재 상태를 확인하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortie trop volumineuse. Actualisez pour vérifier l’état des paquets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viel Befehlsausgabe. Neu laden, um den Paketstatus zu prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando generó demasiada salida. Actualiza para comprobar el estado."
          }
        }
      }
    },
    "The command timed out. Refresh to check the current package state.": {
