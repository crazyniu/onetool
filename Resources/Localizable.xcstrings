    "1Tool is not allowed to control %@. The terminal command was not sent. Open Permissions, enable Automation for this app, then retry the Finder action yourself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1Tool is not allowed to control %@. The terminal command was not sent. Open Permissions, enable Automation for this app, then retry the Finder action yourself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1Tool 尚未获准控制 %@，终端命令未发送。请打开权限管理，为该应用启用自动化权限，再手动重试 Finder 操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1Tool 尚未獲准控制 %@，終端機指令未傳送。請開啟權限管理，為該應用程式啟用自動化權限，再手動重試 Finder 操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1Tool darf %@ nicht steuern. Der Terminalbefehl wurde nicht gesendet. Öffnen Sie die Berechtigungen, erlauben Sie Automation für diese App und wiederholen Sie die Finder-Aktion selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1Tool no tiene permiso para controlar %@. No se envió el comando. Abre Permisos, permite la automatización para esta app y repite manualmente la acción de Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1Tool n’est pas autorisé à contrôler %@. La commande n’a pas été envoyée. Ouvrez les autorisations, activez l’automatisation pour cette app, puis relancez vous-même l’action Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1Tool は %@ を制御する許可がありません。ターミナルコマンドは送信されていません。アクセス権でこのアプリのオートメーションを許可し、Finder 操作を手動で再実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1Tool에 %@ 제어 권한이 없어 터미널 명령을 보내지 않았습니다. 권한 관리에서 이 앱의 자동화를 허용한 후 Finder 작업을 직접 다시 실행하세요."
          }
        }
      }
    },
    "Scanned Cache Usage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanned Cache Usage"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已扫描缓存占用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已掃描快取佔用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン済みキャッシュ使用量"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔한 캐시 사용량"
          }
        },
        "fr": {
