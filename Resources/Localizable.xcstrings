    "Some packages have dependency problems. Available packages are still shown; the inventory may be incomplete.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some packages have dependency problems. Available packages are still shown; the inventory may be incomplete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分包存在依赖问题。已保留可读取的包，列表可能不完整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分套件存在相依性問題。已保留可讀取的套件，清單可能不完整。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のパッケージに依存関係の問題があります。取得できたパッケージを表示していますが、一覧が不完全な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 패키지에 의존성 문제가 있습니다. 읽을 수 있는 패키지는 표시되며 목록이 불완전할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains paquets ont des problèmes de dépendances. Les paquets accessibles restent affichés ; la liste peut être incomplète."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Pakete haben Abhängigkeitsprobleme. Lesbare Pakete bleiben sichtbar; die Liste ist möglicherweise unvollständig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos paquetes tienen problemas de dependencias. Se muestran los paquetes disponibles; la lista puede estar incompleta."
          }
        }
      }
    },
    "The package environment changed. Review the selected environment and confirm again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package environment changed. Review the selected environment and confirm again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包管理环境已变更。请检查所选环境并重新确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
