          }
        }
      }
    },
    "System accessibility settings take priority. Surfaces stay opaque for clarity.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System accessibility settings take priority. Surfaces stay opaque for clarity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先遵循系统辅助功能设置，使用不透明背景保证清晰。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優先遵循系統輔助使用設定，使用不透明背景確保清晰。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen haben Vorrang. Flächen bleiben für gute Lesbarkeit undurchsichtig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La accesibilidad del sistema tiene prioridad; los fondos permanecen opacos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages d’accessibilité priment ; les surfaces restent opaques."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ設定を優先し、読みやすい不透明な背景を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 손쉬운 사용 설정을 우선하여 배경을 불투명하게 유지합니다."
          }
        }
      }
    },
    "This macOS version uses standard translucent materials. Liquid Glass requires macOS 26 or later.": {
