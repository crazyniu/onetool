    "Cleanup uses an allowlist, previews every selection, and rechecks files before changing them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bereinigung nutzt erlaubte Pfade, zeigt die Auswahl und prüft Dateien vor jeder Änderung erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanup uses an allowlist, previews every selection, and rechecks files before changing them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza usa rutas permitidas, muestra la selección y revisa los archivos antes de cambiarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage utilise des chemins autorisés, affiche la sélection et revérifie les fichiers avant modification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されたパスのみを対象に、選択内容を表示し、変更前にファイルを再確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용된 경로만 검사하고 선택 내용을 표시하며 변경 전에 파일을 다시 확인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理采用明确的目录范围，支持预览，并在操作前重新核对文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理採用明確的目錄範圍，支持預覽，並在操作前重新核對文件。"
          }
        }
      }
    },
