    "Changes the appearance of macOS and all apps that follow it. Automatic uses the system schedule.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the appearance of macOS and all apps that follow it. Automatic uses the system schedule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改 macOS 及跟随系统的应用外观；自动模式由系统按时段切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改 macOS 及跟隨系統的 App 外觀；自動模式由系統按時段切換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS とシステム設定に従うアプリの外観を変更します。「自動」はシステムのスケジュールに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS와 시스템 설정을 따르는 앱의 모양을 변경합니다. 자동 모드는 시스템 일정에 따릅니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie l’apparence de macOS et des apps qui suivent le système. Le mode Automatique utilise la programmation du système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Darstellung von macOS und allen Apps, die ihr folgen. Automatisch verwendet den Zeitplan des Systems."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la apariencia de macOS y de las apps que siguen el sistema. Automático utiliza la programación del sistema."
          }
        }
      }
    },
    "System appearance cannot be changed on this macOS version. Use System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System appearance cannot be changed on this macOS version. Use System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本 macOS 暂不支持直接切换外观，请在系统设置中修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本 macOS 暫不支援直接切換外觀，請在系統設定中修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンの macOS では外観を直接変更できません。システム設定を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 macOS 버전에서는 시스템 모양을 직접 변경할 수 없습니다. 시스템 설정을 사용하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apparence ne peut pas être modifiée directement sur cette version de macOS. Utilisez Réglages Système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemdarstellung lässt sich unter dieser macOS-Version nicht direkt ändern. Verwende die Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de macOS no permite cambiar la apariencia directamente. Usa Ajustes del Sistema."
          }
        }
      }
    },
    "macOS did not confirm the appearance change. The previous mode was restored.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS did not confirm the appearance change. The previous mode was restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未确认外观修改，已恢复之前的模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未確認外觀修改，已恢復先前的模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が外観の変更を確認できなかったため、以前のモードに戻しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 모양 변경을 확인하지 못했습니다. 이전 모드로 복원했습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas confirmé le changement d’apparence. Le mode précédent a été rétabli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat die Änderung der Darstellung nicht bestätigt. Der vorherige Modus wurde wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no confirmó el cambio de apariencia. Se restauró el modo anterior."
          }
        }
      }
    },
    "macOS did not confirm the appearance change. Check the current mode in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS did not confirm the appearance change. Check the current mode in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未确认外观修改，请在系统设置中检查当前模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未確認外觀修改，請在系統設定中檢查目前模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が外観の変更を確認できませんでした。システム設定で現在のモードを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 모양 변경을 확인하지 못했습니다. 시스템 설정에서 현재 모드를 확인하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas confirmé le changement d’apparence. Vérifiez le mode actuel dans Réglages Système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat die Änderung der Darstellung nicht bestätigt. Prüfe den aktuellen Modus in den Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no confirmó el cambio de apariencia. Comprueba el modo actual en Ajustes del Sistema."
          }
        }
      }
    },
    "System appearance uses a local system interface and does not request Automation or Accessibility. Unavailable controls open System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System appearance uses a local system interface and does not request Automation or Accessibility. Unavailable controls open System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统外观通过本机接口切换，无需自动化或辅助功能权限；接口不可用时可前往系统设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統外觀透過本機介面切換，無需自動化或輔助使用權限；介面無法使用時可前往系統設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観はローカルのシステム機能で変更するため、オートメーションやアクセシビリティの許可は不要です。利用できない場合はシステム設定を開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 모양은 로컬 시스템 인터페이스를 사용하므로 자동화나 손쉬운 사용 권한을 요청하지 않습니다. 사용할 수 없으면 시스템 설정을 열 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apparence utilise une interface locale sans demander d’autorisation Automatisation ou Accessibilité. Si elle est indisponible, ouvrez Réglages Système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemdarstellung verwendet eine lokale Schnittstelle ohne Automatisierungs- oder Bedienungshilfen-Zugriff. Ist sie nicht verfügbar, öffne die Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La apariencia usa una interfaz local sin solicitar permisos de Automatización ni Accesibilidad. Si no está disponible, abre Ajustes del Sistema."
          }
        }
      }
    },
    "Available upgrades use local Homebrew metadata. Check for Updates refreshes the source.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available upgrades use local Homebrew metadata. Check for Updates refreshes the source."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可升级项目来自本地 Homebrew 元数据。“检查更新”会刷新软件源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可升級項目來自本機 Homebrew 中繼資料。「檢查更新」會重新整理來源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新候補はローカルのHomebrewメタデータに基づきます。「アップデートを確認」で取得元を更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업그레이드 목록은 로컬 Homebrew 메타데이터를 사용합니다. 업데이트 확인으로 소스를 새로 고칩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à niveau utilisent les métadonnées Homebrew locales. Rechercher des mises à jour actualise la source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbare Upgrades basieren auf lokalen Homebrew-Metadaten. Nach Updates suchen aktualisiert die Quelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones usan los metadatos locales de Homebrew. Buscar actualizaciones actualiza la fuente."
          }
        }
      }
    },
