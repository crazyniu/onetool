    "Finder actions may control Finder, Terminal or iTerm2. Permission is separate for each app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder actions may control Finder, Terminal or iTerm2. Permission is separate for each app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 操作可能控制 Finder、终端或 iTerm2，每个应用单独授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 操作可能控制 Finder、終端機或 iTerm2，每個應用程式個別授權。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder-Aktionen können Finder, Terminal oder iTerm2 steuern. Jede App benötigt eine eigene Erlaubnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones de Finder pueden controlar Finder, Terminal o iTerm2. Cada app requiere su propio permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions Finder peuvent contrôler Finder, Terminal ou iTerm2. Chaque app a sa propre autorisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 操作では Finder、ターミナル、iTerm2 を制御する場合があります。許可はアプリごとに必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 작업은 Finder, 터미널, iTerm2를 제어할 수 있으며 앱마다 권한이 필요합니다."
          }
        }
      }
    },
