    "Upgrade these global packages to latest? This can include major version changes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade these global packages to latest? This can include major version changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这些全局包升级到 latest 版本？这可能包含主版本变更。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將這些全域套件升級至 latest 版本？這可能包含主要版本變更。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバルパッケージを latest に更新しますか？メジャーバージョンが変わる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 전역 패키지를 latest로 업그레이드할까요? 주 버전이 변경될 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à niveau vers latest ? Cela peut inclure des changements de version majeure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese globalen Pakete auf latest aktualisieren? Hauptversionen können sich ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
