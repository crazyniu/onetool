    "Some locations could not be fully inspected. Review the paths below, check access, then scan again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some locations could not be fully inspected. Review the paths below, check access, then scan again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分位置未能完整检查，请查看下方路径，确认访问权限后重新扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分位置未能完整檢查，請查看下方路徑，確認存取權限後重新掃描。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Orte wurden nicht vollständig geprüft. Prüfen Sie Pfade und Zugriffsrechte, dann scannen Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas ubicaciones no pudieron revisarse. Comprueba las rutas y el acceso, y vuelve a analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains emplacements n’ont pas été entièrement vérifiés. Vérifiez les chemins et accès, puis relancez."
