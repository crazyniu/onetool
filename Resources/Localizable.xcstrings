          "stringUnit": {
            "state": "translated",
            "value": "Cannot safely inspect this path. Check permissions or use the vendor uninstaller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全检查此路径。请检查权限或使用厂商卸载器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
