    "Follow System keeps the current input source. If a source becomes unavailable, choose another one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemeinstellung behält die aktuelle Eingabequelle bei. Ist sie nicht mehr verfügbar, wähle eine andere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow System keeps the current input source. If a source becomes unavailable, choose another one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir al sistema conserva la fuente actual. Si deja de estar disponible, elige otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre le système conserve la source actuelle. Si elle devient indisponible, choisissez-en une autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システムに従う」では現在の入力ソースを維持します。利用できなくなった場合は別のソースを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 따르기는 현재 입력 소스를 유지합니다. 사용할 수 없는 소스는 다른 것으로 변경하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“跟随系统”会保留当前输入法。输入法停用或移除后，请重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「跟隨系統」會保留目前輸入法。輸入法停用或移除後，請重新選擇。"
          }
        }
      }
    },
